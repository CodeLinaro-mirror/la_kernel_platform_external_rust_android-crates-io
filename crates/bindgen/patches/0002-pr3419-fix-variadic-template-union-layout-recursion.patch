From 0acdfdd74054caec85a75ba20c7ac236f6ebd893 Mon Sep 17 00:00:00 2001
From: Erick Tryzelaar <etryzelaar@google.com>
Date: Thu, 30 Jul 2026 20:53:45 +0000
Subject: [PATCH 2/2] Fix variadic template union layout recursion

Backport upstream PR https://github.com/rust-lang/rust-bindgen/pull/3419

Bug: 573304683
---
 ir/comp.rs | 6 ++++++
 ir/ty.rs   | 6 +++---
 2 files changed, 9 insertions(+), 3 deletions(-)

diff --git a/ir/comp.rs b/ir/comp.rs
index cc90260..406db83 100644
--- a/ir/comp.rs
+++ b/ir/comp.rs
@@ -1122,6 +1122,12 @@ impl CompInfo {
             return None;
         }
 
+        // Uninstantiated template unions do not have layout in C++ and can cause
+        // infinite layout recursion if fields reference the union template.
+        if self.kind == CompKind::Union && !self.template_params.is_empty() {
+            return None;
+        }
+
         let mut max_size = 0;
         // Don't allow align(0)
         let mut max_align = 1;
diff --git a/ir/ty.rs b/ir/ty.rs
index 077802c..ac548c5 100644
--- a/ir/ty.rs
+++ b/ir/ty.rs
@@ -198,9 +198,9 @@ impl Type {
                     None
                 }
             }
-            TypeKind::ResolvedTypeRef(inner) => {
-                ctx.resolve_type(inner).is_incomplete_array(ctx)
-            }
+            TypeKind::ResolvedTypeRef(inner) => ctx
+                .safe_resolve_type(inner)
+                .and_then(|t| t.is_incomplete_array(ctx)),
             _ => None,
         }
     }
